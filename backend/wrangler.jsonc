{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "diary-backend",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": {
    "required": ["JWT_SECRET"],
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Replace this placeholder with the ID created for the Supabase Direct connection.
      "id": "00000000000000000000000000000000",
    },
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01,
    },
  },
}
